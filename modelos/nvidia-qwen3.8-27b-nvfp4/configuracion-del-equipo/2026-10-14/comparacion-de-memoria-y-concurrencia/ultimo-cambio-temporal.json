{
  "services": {
    "vllm": {
      "command": [
        "vllm",
        "serve",
        "nvidia/Qwen3.8-27B-NVFP4",
        "--enable-auto-tool-choice",
        "--tool-call-parser",
        "qwen3_coder",
        "--reasoning-parser",
        "qwen3",
        "--gpu-memory-utilization",
        "0.2",
        "--max-model-len",
        "8192",
        "--max-num-seqs",
        "4"
      ]
    }
  }
}